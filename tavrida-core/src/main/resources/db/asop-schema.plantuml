@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle
hide empty members

entity ASOP_ROLE {
  * ROLE_ID : INT
  --
  ROLE_NAME : VARCHAR
}

entity ASOP_CARD_TYPE {
  * CARD_TYPE_ID : INT
  --
  CARD_TYPE_NAME : VARCHAR
}

entity ASOP_TARIFF_TYPE {
  * TARIFF_TYPE_ID : INT
  CODE : VARCHAR
  --
  NAME : VARCHAR
}

entity ASOP_EVENT_TYPE {
  * EVENT_TYPE : CHAR(4)
  --
  EVENT_TYPE_NAME : VARCHAR
}

entity ASOP_TRANSACTION_TYPE {
  * TRANSACTION_TYPE_ID : INT
  --
  TRANSACTION_TYPE_NAME : VARCHAR
}

entity ASOP_TRANSACTION_RESULT {
  * TRANSACTION_RESULT_ID : INT
  --
  TRANSACTION_RESULT_NAME : VARCHAR
}

entity ASOP_ROUTE_TYPE {
  * ROUTE_TYPE_ID : BIGINT
  --
  ROUTE_TYPE_NAME : VARCHAR
}

entity ASOP_CARRIER {
  * CARRIER_ID : BIGSERIAL
  --
  CARRIER_NAME : VARCHAR
}

entity ASOP_USER {
  * USER_ID : BIGSERIAL
  ROLE_ID : INT
  CARRIER_ID : BIGINT
  --
  USER_FIO : VARCHAR
  PASSWORD_HASH : VARCHAR
}

entity ASOP_VEHICLE {
  * VEHICLE_ID : BIGSERIAL
  CARRIER_ID : BIGINT
  --
  VEHICLE_GUID : UUID
  VEHICLE_NUMBER : VARCHAR
  VEHICLE_NAME : VARCHAR
}

entity ASOP_TERMINAL {
  * TERMINAL_ID : BIGSERIAL
  VEHICLE_ID : BIGINT
  CARRIER_ID : BIGINT
  --
  TERMINAL_GUID : UUID
  TERMINAL_NUMBER : VARCHAR
  TERMINAL_SERIAL : VARCHAR
}

entity ASOP_CARD {
  * CARD_ID : BIGSERIAL
  CARD_TYPE_ID : INT
  USER_ID : BIGINT
  --
  CARD_GUID : UUID
  STATUS : VARCHAR
  ISSUE_DATE : TIMESTAMP
  EXPIRATION_DATE : TIMESTAMP
}

entity ASOP_CARD_MIFARE {
  * CARD_ID : BIGINT
  --
  UID : BYTEA
  ATQA : SMALLINT
  SAK : SMALLINT
  PROTOCOL_VERSION : INT
}

entity ASOP_CARD_BANK {
  * CARD_ID : BIGINT
  --
  PAN_TOKEN : VARCHAR
  PAN_LAST4 : CHAR(4)
  BIN : CHAR(6)
  IS_TOKENIZED : BOOLEAN
}

entity ASOP_CARD_TARIFF {
  * CARD_TARIFF_ID : BIGSERIAL
  CARD_ID : BIGINT
  TARIFF_TYPE_ID : INT
  --
  BALANCE : NUMERIC
  TRAVEL_COUNT : INT
  EXPIRATION_DATE : TIMESTAMP
  IS_ACTIVE : BOOLEAN
}

entity ASOP_BLACKLIST {
  * CARD_GUID : UUID
}

entity ASOP_TARIFF_RATE {
  * TARIFF_RATE_ID : BIGSERIAL
  TARIFF_TYPE_ID : INT
  CARRIER_ID : BIGINT
  ZONE_ID : BIGINT
  --
  PRICE : NUMERIC
  IS_ACTIVE : BOOLEAN
}

entity ASOP_FARE_ZONE {
  * ZONE_ID : BIGSERIAL
  --
  ZONE_CODE : VARCHAR
  ZONE_NAME : VARCHAR
  ZONE_POLYGON : GEOGRAPHY
}

entity ASOP_CARRIER_ZONE {
  * CARRIER_ZONE_ID : BIGSERIAL
  CARRIER_ID : BIGINT
  ZONE_ID : BIGINT
  --
  BASE_FARE : DECIMAL
}

entity ASOP_USER_SESSION {
  * SESSION_ID : UUID
  TERMINAL_ID : BIGINT
  OPENED_BY_USER_ID : BIGINT
  CLOSED_BY_USER_ID : BIGINT
  CARD_ID : BIGINT
  --
  STARTED_AT : TIMESTAMP
  CLOSED_AT : TIMESTAMP
  EXPIRATION_TIME : TIMESTAMP
}

entity ASOP_EVENT {
  * EVENT_ID : BIGSERIAL
  EVENT_TYPE : CHAR(4)
  USER_ID : BIGINT
  SESSION_ID : UUID
  --
  EVENT_TIME : TIMESTAMP
  EVENT_DETAILS : VARCHAR
}

entity ASOP_TRANSACTION {
  * TRANSACTION_ID : BIGSERIAL
  CARD_ID : BIGINT
  CARD_TARIFF_ID : BIGINT
  TERMINAL_ID : BIGINT
  TRANSACTION_TYPE_ID : INT
  TRANSACTION_RESULT_ID : INT
  --
  TRANSACTION_TIME : TIMESTAMP
  BALANCE_BEFORE : NUMERIC
  BALANCE_AFTER : NUMERIC
}

entity ASOP_ROUTE {
  * ROUTE_ID : BIGSERIAL
  ROUTE_TYPE_ID : BIGINT
  PARENT_ROUTE_ID : BIGINT
  --
  ROUTE_GUID : UUID
  ROUTE_NAME : VARCHAR
}

entity ASOP_STOP {
  * STOP_ID : BIGSERIAL
  FARE_ZONE_ID : BIGINT
  --
  STOP_CODE : VARCHAR
  STOP_NAME : VARCHAR
  ZONE_POLYGON : GEOGRAPHY
}

entity ASOP_CARRIER_ROUTE {
  * CARRIER_ROUTE_ID : BIGSERIAL
  CARRIER_ID : BIGINT
  ROUTE_ID : BIGINT
}

entity ASOP_ROUTE_STOP {
  * ROUTE_STOP_ID : BIGSERIAL
  STOP_ID : BIGINT
  ROUTE_ID : BIGINT
}

entity ASOP_STOP_ZONE {
  * STOP_ZONE_ID : BIGSERIAL
  STOP_ID : BIGINT
  ZONE_ID : BIGINT
}

entity ASOP_TRIP {
  * TRIP_ID : BIGSERIAL
  ROUTE_ID : BIGINT
  SESSION_ID : UUID
  --
  STARTED_AT : TIMESTAMP
  CLOSED_AT : TIMESTAMP
}

' ── СВЯЗИ ──────────────────────────────────────────────────────
ASOP_CARRIER ||--o{ ASOP_USER
ASOP_ROLE ||--o{ ASOP_USER
ASOP_CARRIER ||--o{ ASOP_VEHICLE
ASOP_VEHICLE ||--o| ASOP_TERMINAL
ASOP_CARRIER ||--o{ ASOP_TERMINAL

ASOP_CARD_TYPE ||--o{ ASOP_CARD
ASOP_USER ||--o{ ASOP_CARD
ASOP_CARD ||--o| ASOP_CARD_MIFARE
ASOP_CARD ||--o| ASOP_CARD_BANK
ASOP_CARD ||--o{ ASOP_CARD_TARIFF
ASOP_TARIFF_TYPE ||--o{ ASOP_CARD_TARIFF
ASOP_CARD ||--o{ ASOP_BLACKLIST

ASOP_TERMINAL ||--o{ ASOP_USER_SESSION
ASOP_USER ||--o{ ASOP_USER_SESSION : opened
ASOP_USER ||--o{ ASOP_USER_SESSION : closed
ASOP_CARD ||--o{ ASOP_USER_SESSION

ASOP_EVENT_TYPE ||--o{ ASOP_EVENT
ASOP_USER ||--o{ ASOP_EVENT
ASOP_USER_SESSION ||--o{ ASOP_EVENT

ASOP_TRANSACTION_TYPE ||--o{ ASOP_TRANSACTION
ASOP_TRANSACTION_RESULT ||--o{ ASOP_TRANSACTION
ASOP_TERMINAL ||--o{ ASOP_TRANSACTION
ASOP_CARD ||--o{ ASOP_TRANSACTION
ASOP_CARD_TARIFF ||--o| ASOP_TRANSACTION : purchase

ASOP_TARIFF_TYPE ||--o{ ASOP_TARIFF_RATE
ASOP_CARRIER ||--o{ ASOP_TARIFF_RATE
ASOP_FARE_ZONE ||--o{ ASOP_TARIFF_RATE
ASOP_FARE_ZONE ||--o{ ASOP_CARRIER_ZONE
ASOP_CARRIER ||--o{ ASOP_CARRIER_ZONE
ASOP_FARE_ZONE ||--o{ ASOP_STOP

ASOP_ROUTE_TYPE ||--o{ ASOP_ROUTE
ASOP_ROUTE ||--o{ ASOP_TRIP
ASOP_USER_SESSION ||--o{ ASOP_TRIP
ASOP_ROUTE ||--o{ ASOP_CARRIER_ROUTE
ASOP_CARRIER ||--o{ ASOP_CARRIER_ROUTE
ASOP_ROUTE ||--o{ ASOP_ROUTE_STOP
ASOP_STOP ||--o{ ASOP_ROUTE_STOP
ASOP_STOP ||--o{ ASOP_STOP_ZONE
ASOP_FARE_ZONE ||--o{ ASOP_STOP_ZONE
@enduml