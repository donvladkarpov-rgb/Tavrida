@startuml
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam class {
    HeaderBackgroundColor #2C3E50
    HeaderFontColor #FFFFFF
    BackgroundColor #ECF0F1
    BorderColor #34495E
    ArrowColor #7F8C8D
    FontSize 9
    Padding 4
    Margin 8
}
skinparam classAttributeIconSize 0
hide circle
hide empty members

package "🌍 Регионы" {
    entity ASOP_REGIONS {
        * REGION_ID : UUID
        REGION_CODE : VARCHAR(20)
        REGION_NAME : VARCHAR(255)
        # PARENT_REGION_ID : UUID
        DESCRIPTION : TEXT
        IS_ACTIVE : BOOLEAN
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
}

package "📖 Справочники" {
    entity ASOP_ROLES {
        * ROLE_ID : UUID
        ROLE_NAME : VARCHAR(255)
        # REGION_ID : UUID
    }
    entity ASOP_CARD_TYPES {
        * CARD_TYPE_ID : UUID
        CARD_TYPE_NAME : VARCHAR(255)
        # REGION_ID : UUID
    }
    entity ASOP_TARIFF_TYPES {
        * TARIFF_TYPE_ID : UUID
        CODE : VARCHAR(50)
        NAME : VARCHAR(100)
        DESCRIPTION : TEXT
        # REGION_ID : UUID
    }
    entity ASOP_SESSION_TYPES {
        * SESSION_TYPE_ID : UUID
        SESSION_TYPE_CODE : VARCHAR(30)
        SESSION_TYPE_NAME : VARCHAR(100)
        # REGION_ID : UUID
    }
    entity ASOP_EVENT_TYPES {
        * EVENT_TYPE : CHAR(4)
        EVENT_TYPE_NAME : VARCHAR(128)
        # REGION_ID : UUID
    }
    entity ASOP_TRANSACTION_TYPES {
        * TRANSACTION_TYPE_ID : UUID
        TRANSACTION_TYPE_NAME : VARCHAR(255)
        # REGION_ID : UUID
    }
    entity ASOP_TRANSACTION_RESULTS {
        * TRANSACTION_RESULT_ID : UUID
        TRANSACTION_RESULT_NAME : VARCHAR(255)
        # REGION_ID : UUID
    }
    entity ASOP_ROUTE_TYPES {
        * ROUTE_TYPE_ID : UUID
        ROUTE_TYPE_NAME : VARCHAR(16)
        # REGION_ID : UUID
    }
    entity ASOP_ORGANIZERS {
        * ORGANIZER_ID : UUID
        ORGANIZER_NAME : VARCHAR(255)
        REGION_CODE : VARCHAR(50)
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
    }
    entity ASOP_TERRITORIES {
        * TERRITORY_ID : UUID
        TERRITORY_NAME : VARCHAR(255)
        CADASTRAL_NUMBER : VARCHAR(50)
        FIAS_CODE : VARCHAR(50)
        # ORGANIZER_ID : UUID
        # REGION_ID : UUID
        IS_DISPATCH_ACTIVE : BOOLEAN
    }
    entity ASOP_SERVICES {
        * SERVICE_ID : UUID
        SERVICE_CODE : VARCHAR(20)
        SERVICE_NAME : VARCHAR(100)
        DESCRIPTION : TEXT
        IS_DEFAULT : BOOLEAN
        ALLOW_DISCOUNTS : BOOLEAN
        ALLOW_BENEFITS : BOOLEAN
        USE_ZONES : BOOLEAN
        PRIORITY : INT
        ROUTES_LIMIT : INT
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
    }
    entity ASOP_FARE_ZONES {
        * ZONE_ID : UUID
        ZONE_CODE : VARCHAR(20)
        ZONE_NAME : VARCHAR(100)
        DESCRIPTION : VARCHAR(256)
        ZONE_POLYGON : GEOGRAPHY
        # REGION_ID : UUID
    }
    entity ASOP_TRAVEL_ZONES {
        * TRAVEL_ZONE_ID : UUID
        # FARE_ZONE_ID : UUID
        TRAVEL_ZONE_CODE : VARCHAR(30)
        TRAVEL_ZONE_NAME : VARCHAR(100)
        # REGION_ID : UUID
    }
}

package "🚌 Базовые сущности" {
    entity ASOP_CARRIERS {
        * CARRIER_ID : UUID
        CARRIER_NAME : VARCHAR(255)
        # REGION_ID : UUID
    }
    entity ASOP_USERS {
        * USER_ID : UUID
        # ROLE_ID : UUID
        # CARRIER_ID : UUID
        SNILS : VARCHAR(14)
        PHONE : VARCHAR(20)
        USER_FIO : VARCHAR(255)
        PASSWORD_HASH : VARCHAR(255)
        # REGION_ID : UUID
    }
    entity ASOP_VEHICLES {
        * VEHICLE_ID : UUID
        # CARRIER_ID : UUID
        VEHICLE_NUMBER : VARCHAR(16)
        VEHICLE_NAME : VARCHAR(255)
        VEHICLE_MODEL : VARCHAR(100)
        # REGION_ID : UUID
    }
    entity ASOP_TERMINALS {
        * TERMINAL_ID : UUID
        # CARRIER_ID : UUID
        TERMINAL_NUMBER : VARCHAR(16)
        TERMINAL_SERIAL : VARCHAR(64)
        # REGION_ID : UUID
    }
    entity ASOP_TIDS {
        * TID_ID : UUID
        # CARRIER_ID : UUID
        TID_VALUE : VARCHAR(20)
        STATUS : VARCHAR(20)
        ASSIGNED_AT : TIMESTAMP
        UNASSIGNED_AT : TIMESTAMP
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
}

package "🗺 Маршруты и расписание" {
    entity ASOP_ROUTES {
        * ROUTE_ID : UUID
        # ROUTE_TYPE_ID : UUID
        # PARENT_ROUTE_ID : UUID
        ROUTE_NAME : VARCHAR(128)
        MINISTRY_REGISTRY_NO : VARCHAR(50)
        ROUTE_CATEGORY : VARCHAR(30)
        # TERRITORY_ID : UUID
        # ORGANIZER_ID : UUID
        # REGION_ID : UUID
        ROUTE_START_DATE : TIMESTAMP
        ROUTE_END_DATE : TIMESTAMP
        BENEFIT_POLICY : VARCHAR(20)
        ROUTE_OBJECT : JSONB
        DESCRIPTION : VARCHAR(512)
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_TRANSPORT_STOPS {
        * STOP_ID : UUID
        # FARE_ZONE_ID : UUID
        # TRAVEL_ZONE_ID : UUID
        STOP_CODE : VARCHAR(20)
        STOP_NAME : VARCHAR(200)
        STOP_ADDRESS : VARCHAR(500)
        ZONE_POLYGON : GEOGRAPHY
        DESCRIPTION : TEXT
        # REGION_ID : UUID
        IS_ACTIVE : BOOLEAN
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_ROUTE_TRANSPORT_STOPS {
        * ROUTE_STOP_ID : UUID
        # STOP_ID : UUID
        # ROUTE_ID : UUID
        SERIAL_NUMBER : INT
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_SCHEDULE {
        * SCHEDULE_ID : UUID
        # ROUTE_ID : UUID
        # STOP_ID : UUID
        DAY_MASK : INT
        ARRIVAL_TIME : TIME
        DWELL_TIME_SEC : INT
        # REGION_ID : UUID
        IS_ACTIVE : BOOLEAN
    }
    entity ASOP_ROUTE_SERVICES {
        * ROUTE_SERVICE_ID : UUID
        # ROUTE_ID : UUID
        # SERVICE_ID : UUID
        # REGION_ID : UUID
    }
    entity ASOP_ROUTE_CARD_TYPES {
        * ROUTE_CARD_TYPE_ID : UUID
        # ROUTE_ID : UUID
        # CARD_TYPE_ID : UUID
        IS_ENABLED : BOOLEAN
        # REGION_ID : UUID
    }
    entity ASOP_ROUTE_DISCOUNTS {
        * ROUTE_DISCOUNT_ID : UUID
        # ROUTE_ID : UUID
        DISCOUNT_NAME : VARCHAR(100)
        DISCOUNT_PERCENT : NUMERIC(5,2)
        # REGION_ID : UUID
        VALID_FROM : TIMESTAMP
        VALID_UNTIL : TIMESTAMP
        IS_ACTIVE : BOOLEAN
    }
}

package "💳 Карты, льготы, тарифы" {
    entity ASOP_CARDS {
        * CARD_ID : UUID
        # CARD_TYPE_ID : UUID
        # USER_ID : UUID
        REGISTERED_AT : TIMESTAMP
        REGISTERED_BY_USER_ID : UUID
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_CARD_MIFARES {
        * # CARD_ID : UUID
        UID : BYTEA
        ATQA : SMALLINT
        SAK : SMALLINT
        PROTOCOL_VERSION : INT
        MEMORY_MAP : JSONB
    }
    entity ASOP_CARD_BANKS {
        * # CARD_ID : UUID
        PAN_TOKEN : VARCHAR(256)
        PAN_LAST4 : CHAR(4)
        BIN : CHAR(6)
        IS_TOKENIZED : BOOLEAN
    }
    entity ASOP_CARD_TARIFFS {
        * CARD_TARIFF_ID : UUID
        # CARD_ID : UUID
        # TARIFF_TYPE_ID : UUID
        BALANCE : NUMERIC(10,2)
        TRAVEL_COUNT : INT
        MAX_TRAVEL_COUNT : INT
        EXPIRATION_DATE : TIMESTAMP
        ACTIVATED_AT : TIMESTAMP
        # PURCHASE_TRANSACTION_ID : UUID
        # REGION_ID : UUID
        IS_ACTIVE : BOOLEAN
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_BLACKLISTS {
        * # CARD_ID : UUID
        BLOCK_TYPE : VARCHAR(20)
        BLOCKED_AT : TIMESTAMP
        # REGION_ID : UUID
    }
    entity ASOP_BENEFITS {
        * BENEFIT_ID : UUID
        BENEFIT_CODE : VARCHAR(50)
        BENEFIT_NAME : VARCHAR(100)
        REGION_CODE : VARCHAR(50)
        DESCRIPTION : TEXT
        # REGION_ID : UUID
        IS_ACTIVE : BOOLEAN
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_BENEFIT_STEPS {
        * STEP_ID : UUID
        # BENEFIT_ID : UUID
        STEP_ORDER : INT
        TRIP_THRESHOLD_FROM : INT
        TRIP_THRESHOLD_TO : INT
        DISCOUNT_SHARE : NUMERIC(4,2)
        PERIOD_TYPE : VARCHAR(20)
    }
    entity ASOP_USER_BENEFITS {
        * ASSIGNMENT_ID : UUID
        # USER_ID : UUID
        # BENEFIT_ID : UUID
        # REGION_ID : UUID
        VALID_FROM : TIMESTAMP
        VALID_UNTIL : TIMESTAMP
        SYNC_VERSION : INT
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_ROUTE_BENEFITS {
        * ROUTE_BENEFIT_ID : UUID
        # ROUTE_ID : UUID
        # BENEFIT_ID : UUID
        # REGION_ID : UUID
    }
    entity ASOP_TARIFF_RATES {
        * TARIFF_RATE_ID : UUID
        # TARIFF_TYPE_ID : UUID
        # CARRIER_ID : UUID
        # ZONE_ID : UUID
        # ROUTE_ID : UUID
        PRICE : NUMERIC(10,2)
        DESCRIPTION : TEXT
        # REGION_ID : UUID
        IS_ACTIVE : BOOLEAN
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_CARRIER_ZONES {
        * CARRIER_ZONE_ID : UUID
        # CARRIER_ID : UUID
        # ZONE_ID : UUID
        BASE_FARE : DECIMAL(10,2)
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
}

package "👥 Сессии, транзакции, аудит, КРС" {
    entity ASOP_SESSIONS {
        * SESSION_ID : UUID
        # SESSION_TYPE_ID : UUID
        # PARENT_SESSION_ID : UUID
        # TERMINAL_ID : UUID
        # TID_ID : UUID
        # OPENED_BY_USER_ID : UUID
        # CLOSED_BY_USER_ID : UUID
        # CARD_ID : UUID
        # ROUTE_ID : UUID
        # VEHICLE_ID : UUID
        STARTED_AT : TIMESTAMP
        CLOSED_AT : TIMESTAMP
        STARTED_AT_LOCAL : TIMESTAMP
        CLOSED_AT_LOCAL : TIMESTAMP
        EXPIRATION_TIME : TIMESTAMP
        STATUS : VARCHAR(20)
        ATTRIBUTES : JSONB
        # REGION_ID : UUID
    }
    entity ASOP_AUDIT_SERVICES {
        * AUDIT_SERVICE_ID : UUID
        SERVICE_CODE : VARCHAR(50)
        SERVICE_NAME : VARCHAR(255)
        ISSUER_TYPE : VARCHAR(20)
        # ORGANIZER_ID : UUID
        # CARRIER_ID : UUID
        # REGION_ID : UUID
        IS_ACTIVE : BOOLEAN
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_AUDIT_SERVICE_TERRITORIES {
        * SERVICE_TERRITORY_ID : UUID
        # AUDIT_SERVICE_ID : UUID
        # TERRITORY_ID : UUID
        # REGION_ID : UUID
    }
    entity ASOP_AUDIT_TASKS {
        * TASK_ID : UUID
        TASK_NUMBER : VARCHAR(50)
        ISSUER_TYPE : VARCHAR(20)
        # ORGANIZER_ID : UUID
        # CARRIER_ID : UUID
        # ASSIGNED_AUDIT_SERVICE_ID : UUID
        TASK_START_DATE : TIMESTAMP
        TASK_END_DATE : TIMESTAMP
        STATUS : VARCHAR(20)
        DESCRIPTION : TEXT
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_AUDIT_TASK_ROUTES {
        * TASK_ROUTE_ID : UUID
        # TASK_ID : UUID
        # ROUTE_ID : UUID
        # REGION_ID : UUID
    }
    entity ASOP_AUDIT_BRIGADES {
        * BRIGADE_ID : UUID
        # TASK_ID : UUID
        # FOREMAN_USER_ID : UUID
        BRIGADE_STATUS : VARCHAR(20)
        STARTED_AT : TIMESTAMP
        CLOSED_AT : TIMESTAMP
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_AUDIT_BRIGADE_MEMBERS {
        * MEMBER_ID : UUID
        # BRIGADE_ID : UUID
        # USER_ID : UUID
        ROLE : VARCHAR(20)
        # REGION_ID : UUID
    }
    entity ASOP_AUDIT_INSPECTIONS {
        * INSPECTION_ID : UUID
        # BRIGADE_ID : UUID
        # CONTROLLER_SESSION_ID : UUID
        INSPECTION_START : TIMESTAMP
        INSPECTION_END : TIMESTAMP
        DURATION : INTERVAL
        PATH_NAME : VARCHAR(255)
        PASSENGERS_CHECKED : INT
        PASSENGERS_PAID : INT
        PASSENGERS_COMPENSATED : INT
        PASSENGERS_UNPAID : INT
        FINES_COUNT : INT
        STATUS : VARCHAR(20)
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_AUDIT_INSPECTION_TASKS {
        * INSPECTION_TASK_ID : UUID
        # INSPECTION_ID : UUID
        # TASK_ID : UUID
        # REGION_ID : UUID
    }
    entity ASOP_TRANSACTIONS {
        * TRANSACTION_ID : UUID
        STARTED_AT : TIMESTAMP
        COMPLETED_AT : TIMESTAMP
        # SESSION_ID : UUID
        # TRANSACTION_TYPE_ID : UUID
        # TRANSACTION_RESULT_ID : UUID
        AMOUNT : NUMERIC(10,2)
        CURRENCY : CHAR(3)
        ACQUIRER_REFERENCE : VARCHAR(128)
        ERROR_CODE : VARCHAR(50)
        ERROR_MESSAGE : VARCHAR(512)
        METADATA : JSONB
        # REGION_ID : UUID
    }
    entity ASOP_TRANSACTION_CARDS {
        * TRANSACTION_CARD_ID : UUID
        # TRANSACTION_ID : UUID
        # CARD_ID : UUID
        CARD_ROLE : VARCHAR(20)
        # TARIFF_APPLIED_ID : UUID
        BALANCE_BEFORE : NUMERIC(10,2)
        BALANCE_AFTER : NUMERIC(10,2)
        # REGION_ID : UUID
    }
    entity ASOP_DISPATCH_POSITIONS {
        * POSITION_ID : UUID
        # VEHICLE_ID : UUID
        # ROUTE_ID : UUID
        # SESSION_ID : UUID
        GPS_COORD : GEOGRAPHY
        RECORDED_AT : TIMESTAMP
        SPEED_KMH : NUMERIC(5,2)
        STATUS : VARCHAR(30)
        # REGION_ID : UUID
    }
    entity ASOP_CARRIER_ROUTES {
        * CARRIER_ROUTE_ID : UUID
        # CARRIER_ID : UUID
        # ROUTE_ID : UUID
        # REGION_ID : UUID
        CREATED_AT : TIMESTAMP
        UPDATED_AT : TIMESTAMP
    }
    entity ASOP_EVENTS {
        * EVENT_ID : UUID
        EVENT_TIME : TIMESTAMP
        EVENT_LOCAL_TIME : TIMESTAMP
        # EVENT_TYPE : CHAR(4)
        # USER_ID : UUID
        # SESSION_ID : UUID
        REFERENCE_TYPE_ID : INT
        REFERENCE_ID : UUID
        EVENT_DETAILS : VARCHAR(256)
        EVENT_OBJECT : JSONB
        # REGION_ID : UUID
    }
}

