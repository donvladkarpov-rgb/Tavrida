@startuml
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam class {
    HeaderBackgroundColor #2C3E50
    HeaderFontColor #FFFFFF
    BackgroundColor #FDFDFD
    BorderColor #34495E
    ArrowColor #E74C3C
    FontSize 9
