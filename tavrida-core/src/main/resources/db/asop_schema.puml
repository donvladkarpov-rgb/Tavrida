' =========================================================
' ПОЛНЫЙ СПИСОК ВСЕХ СВЯЗЕЙ (Foreign Keys)
' =========================================================

' 0. Регионы
ASOP_TERRITORIES --> ASOP_REGIONS
ASOP_ORGANIZER_TERRITORIES --> ASOP_ORGANIZERS
ASOP_ORGANIZER_TERRITORIES --> ASOP_TERRITORIES

' 1. Справочники
ASOP_SERVICES --> ASOP_REGIONS
ASOP_BENEFIT_STEPS --> ASOP_BENEFITS

' 2. Перевозчики, Дистрибьюторы и Договоры
ASOP_CARRIERS --> ASOP_REGIONS
ASOP_CONTRACTS --> ASOP_CARRIERS
ASOP_CONTRACTS --> ASOP_CARDS_DISTRIBUTORS
ASOP_CONTRACT_ROUTES --> ASOP_CONTRACTS
ASOP_CONTRACT_ROUTES --> ASOP_ROUTES

' 3. Маршруты
ASOP_ROUTES --> ASOP_ORGANIZERS
ASOP_ROUTES --> ASOP_REGIONS
ASOP_PATHS --> ASOP_ROUTES
ASOP_PATHS --> ASOP_TRANSPORT_STOPS : start_stop
ASOP_PATHS --> ASOP_TRANSPORT_STOPS : end_stop
ASOP_PATHS --> ASOP_REGIONS
ASOP_FARE_ZONES --> ASOP_REGIONS
ASOP_TRANSPORT_STOPS --> ASOP_FARE_ZONES
ASOP_PATH_TRANSPORT_STOPS --> ASOP_PATHS
ASOP_PATH_TRANSPORT_STOPS --> ASOP_TRANSPORT_STOPS
ASOP_SCHEDULE --> ASOP_PATHS
ASOP_SCHEDULE --> ASOP_TRANSPORT_STOPS
ASOP_PATH_SERVICES --> ASOP_PATHS
ASOP_PATH_SERVICES --> ASOP_SERVICES
ASOP_PATH_SERVICES --> ASOP_CARRIERS
ASOP_PATH_SERVICES --> ASOP_VEHICLES
ASOP_PATH_SERVICES --> ASOP_TARIFF_TYPES
ASOP_PATH_DISCOUNTS --> ASOP_PATHS
ASOP_PATH_DISCOUNTS --> ASOP_CARRIERS
ASOP_PATH_DISCOUNTS --> ASOP_VEHICLES
ASOP_PATH_DISCOUNTS --> ASOP_TARIFF_TYPES
ASOP_PATH_BENEFITS --> ASOP_PATHS
ASOP_PATH_BENEFITS --> ASOP_BENEFITS

' 4. Транспортные средства
ASOP_VEHICLES --> ASOP_CARRIERS
ASOP_VEHICLES --> ASOP_VEHICLE_TYPES
ASOP_VEHICLES --> ASOP_VEHICLE_MODELS

' 5. Пользователи
ASOP_USER_ROLES --> ASOP_USERS
ASOP_USER_ROLES --> ASOP_ROLES
ASOP_USER_CARRIERS --> ASOP_USERS
ASOP_USER_CARRIERS --> ASOP_CARRIERS
ASOP_USER_REGIONS --> ASOP_USERS
ASOP_USER_REGIONS --> ASOP_REGIONS

' 6. Оборудование
ASOP_DISTRIBUTOR_TERMINALS --> ASOP_CARDS_DISTRIBUTORS
ASOP_DISTRIBUTOR_TERMINALS --> ASOP_CONTRACTS
ASOP_DISTRIBUTOR_TERMINALS --> ASOP_USERS : mol_user
ASOP_DISTRIBUTOR_TERMINALS --> ASOP_TERMINAL_PROFILES
ASOP_DISTRIBUTOR_TERMINALS --> ASOP_TERMINAL_SOFTWARE
ASOP_TIDS --> ASOP_CARRIERS
ASOP_TIDS --> ASOP_TERMINALS
ASOP_TERMINALS --> ASOP_CARRIERS
ASOP_TERMINALS --> ASOP_USERS : mol_user
ASOP_TERMINALS --> ASOP_TERMINALS : parent
ASOP_TERMINALS --> ASOP_TIDS
ASOP_TERMINALS --> ASOP_VEHICLES
ASOP_TERMINALS --> ASOP_TERMINAL_PROFILES
ASOP_TERMINALS --> ASOP_TERMINAL_SOFTWARE

' 7. Карты, Льготы, Тарифы, Платежи
ASOP_CARDS --> ASOP_CARD_TYPES
ASOP_CARDS --> ASOP_USERS
ASOP_CARD_MIFARES --> ASOP_CARDS
ASOP_CARD_BANKS --> ASOP_CARDS
ASOP_CARD_TARIFFS --> ASOP_CARDS
ASOP_CARD_TARIFFS --> ASOP_TARIFF_TYPES
ASOP_CARD_TARIFFS --> ASOP_TRANSACTIONS : purchase
ASOP_BLACKLISTS --> ASOP_CARDS
ASOP_USER_BENEFITS --> ASOP_USERS
ASOP_USER_BENEFITS --> ASOP_BENEFITS
ASOP_TARIFF_RATES --> ASOP_TARIFF_TYPES
ASOP_TARIFF_RATES --> ASOP_CARRIERS
ASOP_TARIFF_RATES --> ASOP_FARE_ZONES
ASOP_TARIFF_RATES --> ASOP_PATHS
ASOP_PAYMENTS --> ASOP_CARDS
ASOP_PAYMENTS --> ASOP_SESSIONS
ASOP_PAYMENTS --> ASOP_EVENTS
ASOP_PAYMENTS --> ASOP_USERS
ASOP_PAYMENTS --> ASOP_DISTRIBUTOR_TERMINALS

' 8. Сессии, Транзакции, Аудит, КРС
ASOP_SESSIONS --> ASOP_SESSION_TYPES
ASOP_SESSIONS --> ASOP_SESSIONS : parent
ASOP_SESSIONS --> ASOP_TERMINALS
ASOP_SESSIONS --> ASOP_TIDS
ASOP_SESSIONS --> ASOP_USERS : opened
ASOP_SESSIONS --> ASOP_USERS : closed
ASOP_SESSIONS --> ASOP_CARDS
ASOP_SESSIONS --> ASOP_PATHS
ASOP_SESSIONS --> ASOP_VEHICLES

ASOP_AUDIT_SERVICES --> ASOP_ORGANIZERS
ASOP_AUDIT_SERVICES --> ASOP_CARRIERS
ASOP_AUDIT_TASKS --> ASOP_ORGANIZERS
ASOP_AUDIT_TASKS --> ASOP_CARRIERS
ASOP_AUDIT_TASKS --> ASOP_AUDIT_SERVICES
ASOP_AUDIT_TASK_PATHS --> ASOP_AUDIT_TASKS
ASOP_AUDIT_TASK_PATHS --> ASOP_PATHS
ASOP_AUDIT_BRIGADES --> ASOP_AUDIT_TASKS
ASOP_AUDIT_BRIGADES --> ASOP_USERS : foreman
ASOP_AUDIT_BRIGADE_MEMBERS --> ASOP_AUDIT_BRIGADES
ASOP_AUDIT_BRIGADE_MEMBERS --> ASOP_USERS
ASOP_AUDIT_INSPECTIONS --> ASOP_AUDIT_BRIGADES
ASOP_AUDIT_INSPECTIONS --> ASOP_SESSIONS : controller
ASOP_AUDIT_INSPECTIONS --> ASOP_PATHS
ASOP_AUDIT_INSPECTION_TASKS --> ASOP_AUDIT_INSPECTIONS
ASOP_AUDIT_INSPECTION_TASKS --> ASOP_AUDIT_TASKS

ASOP_TRANSACTIONS --> ASOP_SESSIONS
ASOP_TRANSACTIONS --> ASOP_TRANSACTION_TYPES
ASOP_TRANSACTIONS --> ASOP_TRANSACTION_RESULTS
ASOP_TRANSACTION_CARDS --> ASOP_TRANSACTIONS
ASOP_TRANSACTION_CARDS --> ASOP_CARDS
ASOP_TRANSACTION_CARDS --> ASOP_CARD_TARIFFS

ASOP_GPS_TRACKING --> ASOP_VEHICLES
ASOP_GPS_TRACKING --> ASOP_PATHS
ASOP_GPS_TRACKING --> ASOP_SESSIONS

ASOP_EVENTS --> ASOP_EVENT_TYPES
ASOP_EVENTS --> ASOP_SESSIONS
ASOP_EVENTS --> ASOP_USERS

@enduml