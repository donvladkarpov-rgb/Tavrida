<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- USER_SESSIONS -->
    <changeSet id="2-1" author="dev">
        <createTable tableName="USER_SESSIONS">
            <column name="SESSION_ID" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TERMINAL_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRATION_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="USER_SESSIONS" indexName="IX_SESSIONS">
            <column name="SESSION_ID"/>
            <column name="USER_ID"/>
            <column name="EXPIRATION_TIME"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="USER_SESSIONS"
                                 baseColumnNames="TERMINAL_ID"
                                 constraintName="fk_sessions_terminal_id"
                                 referencedTableName="TERMINALS"
                                 referencedColumnNames="TERMINAL_ID"/>
        <addForeignKeyConstraint baseTableName="USER_SESSIONS"
                                 baseColumnNames="USER_ID"
                                 constraintName="fk_sessions_user_id"
                                 referencedTableName="USERS"
                                 referencedColumnNames="USER_ID"/>
    </changeSet>

    <!-- CODES -->
    <changeSet id="2-2" author="dev">
        <createTable tableName="CODES">
            <column name="CODE_UID" type="VARCHAR(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CODE_TYPE" type="CHAR(1)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE_CONTENT" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="ALLOWED_USAGE" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_FROM" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_TO" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql">
            <![CDATA[
                ALTER TABLE CODES
                ADD CONSTRAINT chk_codes_type CHECK (CODE_TYPE IN ('A', 'S'));

                ALTER TABLE CODES
                ADD CONSTRAINT chk_codes_usage CHECK (ALLOWED_USAGE IN ('RW', 'R', '-'));
            ]]>
        </sql>
    </changeSet>

    <!-- MASTER_PASSWORD -->
    <changeSet id="2-3" author="dev">
        <createTable tableName="MASTER_PASSWORD">
            <column name="ID" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="MASTER_PASSWORD_HASH" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- SERVICE_EVENT_TYPES -->
    <changeSet id="2-4" author="dev">
        <createTable tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" type="CHAR(2)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="EVENT_TYPE_NAME" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="CU"/>
            <column name="EVENT_TYPE_NAME" value="Создание пользователя"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="CC"/>
            <column name="EVENT_TYPE_NAME" value="Создание карты"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="DU"/>
            <column name="EVENT_TYPE_NAME" value="Удаление пользователя"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="DC"/>
            <column name="EVENT_TYPE_NAME" value="Удаление карты"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="OE"/>
            <column name="EVENT_TYPE_NAME" value="Другое событие"/>
        </insert>
    </changeSet>

    <!-- SERVICE_EVENTS -->
    <changeSet id="2-5" author="dev">
        <createTable tableName="SERVICE_EVENTS">
            <column name="SERVICE_EVENT_ID" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="EVENT_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="SERVICE_EVENT_TYPE" type="CHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="DOER_USER_ID" type="BIGINT"/>
            <column name="REFERENCE_TYPE_ID" type="INT"/>
            <column name="REFERENCE_ID" type="BIGINT"/>
            <column name="EVENT_DETAILS" type="VARCHAR(256)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="SERVICE_EVENTS"
                                 baseColumnNames="SERVICE_EVENT_TYPE"
                                 constraintName="fk_service_events_type"
                                 referencedTableName="SERVICE_EVENT_TYPES"
                                 referencedColumnNames="EVENT_TYPE"/>
    </changeSet>

    <!-- PAYMENT_TYPES -->
    <changeSet id="2-6" author="dev">
        <createTable tableName="PAYMENT_TYPES">
            <column name="PAYMENT_TYPE_ID" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PAYMENT_TYPE_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="PAYMENT_TYPES">
            <column name="PAYMENT_TYPE_ID" valueNumeric="1"/>
            <column name="PAYMENT_TYPE_NAME" value="Пополнение"/>
        </insert>
        <insert tableName="PAYMENT_TYPES">
            <column name="PAYMENT_TYPE_ID" valueNumeric="2"/>
            <column name="PAYMENT_TYPE_NAME" value="Списание"/>
        </insert>
    </changeSet>

    <!-- PAYMENT_RESULTS -->
    <changeSet id="2-7" author="dev">
        <createTable tableName="PAYMENT_RESULTS">
            <column name="PAYMENT_RESULT_ID" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PAYMENT_RESULT_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="PAYMENT_RESULTS">
            <column name="PAYMENT_RESULT_ID" valueNumeric="11"/>
            <column name="PAYMENT_RESULT_NAME" value="Успех"/>
        </insert>
        <insert tableName="PAYMENT_RESULTS">
            <column name="PAYMENT_RESULT_ID" valueNumeric="12"/>
            <column name="PAYMENT_RESULT_NAME" value="Ошибка - карта не читается"/>
        </insert>
        <insert tableName="PAYMENT_RESULTS">
            <column name="PAYMENT_RESULT_ID" valueNumeric="13"/>
            <column name="PAYMENT_RESULT_NAME" value="Ошибка - недостаточно средств"/>
        </insert>
        <insert tableName="PAYMENT_RESULTS">
            <column name="PAYMENT_RESULT_ID" valueNumeric="14"/>
            <column name="PAYMENT_RESULT_NAME" value="Ошибка - карта заблокирована"/>
        </insert>
    </changeSet>

    <!-- PAYMENTS -->
    <changeSet id="2-8" author="dev">
        <createTable tableName="PAYMENTS">
            <column name="PAYMENT_ID" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PAYMENT_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CARD_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="BALANCE_BEFORE" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="BALANCE_AFTER" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="PAYMENT_TYPE_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="PAYMENT_RESULT_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="TERMINAL_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="PAYMENTS"
                                 baseColumnNames="CARD_ID"
                                 constraintName="fk_payments_card"
                                 referencedTableName="CARDS"
                                 referencedColumnNames="CARD_ID"/>

        <addForeignKeyConstraint baseTableName="PAYMENTS"
                                 baseColumnNames="TERMINAL_ID"
                                 constraintName="fk_payments_terminal"
                                 referencedTableName="TERMINALS"
                                 referencedColumnNames="TERMINAL_ID"/>

        <addForeignKeyConstraint baseTableName="PAYMENTS"
                                 baseColumnNames="PAYMENT_TYPE_ID"
                                 constraintName="fk_payments_type"
                                 referencedTableName="PAYMENT_TYPES"
                                 referencedColumnNames="PAYMENT_TYPE_ID"/>

        <addForeignKeyConstraint baseTableName="PAYMENTS"
                                 baseColumnNames="PAYMENT_RESULT_ID"
                                 constraintName="fk_payments_result"
                                 referencedTableName="PAYMENT_RESULTS"
                                 referencedColumnNames="PAYMENT_RESULT_ID"/>

        <createIndex tableName="PAYMENTS" indexName="idx_payments_card_id">
            <column name="CARD_ID"/>
        </createIndex>
        <createIndex tableName="PAYMENTS" indexName="idx_payments_terminal_id">
            <column name="TERMINAL_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>