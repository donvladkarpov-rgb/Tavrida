        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="DU"/>
            <column name="EVENT_TYPE_NAME" value="Удаление пользователя"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="DC"/>
            <column name="EVENT_TYPE_NAME" value="Удаление карты"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="TA"/>
            <column name="EVENT_TYPE_NAME" value="Активация терминала"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="TD"/>
            <column name="EVENT_TYPE_NAME" value="Деактивация терминала"/>
        </insert>
        <insert tableName="SERVICE_EVENT_TYPES">
            <column name="EVENT_TYPE" value="DS"/>
            <column name="EVENT_TYPE_NAME" value="Открытие смены водителя"/>
