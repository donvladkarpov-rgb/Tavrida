        </insert>
    </changeSet>

    <!-- 19. PAYMENTS -->
    <changeSet id="19" author="Vlad">
        <createTable tableName="PAYMENTS">
            <column name="PAYMENT_ID" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PAYMENT_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CARD_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="BALANCE_BEFORE" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="BALANCE_AFTER" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="PAYMENT_TYPE_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="PAYMENT_RESULT_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="TERMINAL_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            <![CDATA[
                ALTER SEQUENCE PAYMENTS_PAYMENT_ID_SEQ RESTART WITH 1000;
            ]]>
        </sql>

        <addForeignKeyConstraint baseTableName="PAYMENTS"
                                 baseColumnNames="CARD_ID"
                                 constraintName="fk_payments_card"
                                 referencedTableName="CARDS"
                                 referencedColumnNames="CARD_ID"/>

        <addForeignKeyConstraint baseTableName="PAYMENTS"
                                 baseColumnNames="TERMINAL_ID"
