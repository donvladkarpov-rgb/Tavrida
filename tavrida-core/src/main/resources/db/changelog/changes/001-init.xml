<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. Справочник ролей пользователей -->
    <changeSet id="1" author="Vlad">
        <createTable tableName="USER_ROLES">
            <column name="USER_ROLE_ID" type="INT" autoIncrement="false">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="USER_ROLE_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="1"/>
            <column name="USER_ROLE_NAME" value="Администратор"/>
        </insert>
        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="2"/>
            <column name="USER_ROLE_NAME" value="Администратор перевозчика"/>
        </insert>
        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="3"/>
            <column name="USER_ROLE_NAME" value="Кассир"/>
        </insert>
        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="4"/>
            <column name="USER_ROLE_NAME" value="Водитель"/>
        </insert>
    </changeSet>

    <!-- 2. Справочник типов карт -->
    <changeSet id="2" author="Vlad">
        <createTable tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" type="INT" autoIncrement="false">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CARD_TYPE_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="1"/>
            <column name="CARD_TYPE_NAME" value="Карта администратора"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="2"/>
            <column name="CARD_TYPE_NAME" value="Карта кассира"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="3"/>
            <column name="CARD_TYPE_NAME" value="Карта водителя"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="4"/>
            <column name="CARD_TYPE_NAME" value="Карта пассажира"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="5"/>
            <column name="CARD_TYPE_NAME" value="Карта активации терминала"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="6"/>
            <column name="CARD_TYPE_NAME" value="Карта сброса терминала"/>
        </insert>
    </changeSet>

    <!-- 3. Перевозчики -->
    <changeSet id="3" author="Vlad">
        <createTable tableName="CARRIERS">
            <column name="CARRIER_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CARRIER_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql">
            <![CDATA[
                ALTER SEQUENCE CARRIERS_CARRIER_ID_SEQ RESTART WITH 1000;
            ]]>
        </sql>
    </changeSet>

    <!-- 4. Пользователи -->
    <changeSet id="4" author="Vlad">
        <createTable tableName="USERS">
            <column name="USER_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="USER_ROLE_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_FIO" type="VARCHAR(255)"/>
            <column name="CARRIER_ID" type="BIGINT"/>
            <column name="USER_PASSWORD_HASH" type="VARCHAR(255)"/>
        </createTable>

        <sql dbms="postgresql">
            <![CDATA[
                ALTER SEQUENCE USERS_USER_ID_SEQ RESTART WITH 1000;
            ]]>
        </sql>

        <addForeignKeyConstraint baseTableName="USERS"
                                 baseColumnNames="USER_ROLE_ID"
                                 constraintName="fk_users_user_role_id"
                                 referencedTableName="USER_ROLES"
                                 referencedColumnNames="USER_ROLE_ID"/>

        <addForeignKeyConstraint baseTableName="USERS"
                                 baseColumnNames="CARRIER_ID"
                                 constraintName="fk_users_carrier_id"
                                 referencedTableName="CARRIERS"
                                 referencedColumnNames="CARRIER_ID"/>

    </changeSet>

    <!-- 5. Транспорт -->
    <changeSet id="5" author="Vlad">
        <createTable tableName="TRANSPORTS">
            <column name="TRANSPORT_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TRANSPORT_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="CARRIER_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="TRANSPORT_NUMBER" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="TRANSPORT_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            <![CDATA[
                ALTER SEQUENCE TRANSPORTS_TRANSPORT_ID_SEQ RESTART WITH 1000;
            ]]>
        </sql>

        <addForeignKeyConstraint baseTableName="TRANSPORTS"
                                 baseColumnNames="CARRIER_ID"
                                 constraintName="fk_transports_carrier_id"
                                 referencedTableName="CARRIERS"
                                 referencedColumnNames="CARRIER_ID"/>
    </changeSet>

    <!-- 6. Терминалы -->
    <changeSet id="6" author="Vlad">
        <createTable tableName="TERMINALS">
            <column name="TERMINAL_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TRANSPORT_ID" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="TERMINAL_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="TERMINAL_NUMBER" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="TERMINAL_SERIAL" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            <![CDATA[
                ALTER SEQUENCE TERMINALS_TERMINAL_ID_SEQ RESTART WITH 1000;
            ]]>
        </sql>

        <addForeignKeyConstraint baseTableName="TERMINALS"
                                 baseColumnNames="TRANSPORT_ID"
                                 constraintName="fk_terminals_transport_id"
                                 referencedTableName="TRANSPORTS"
                                 referencedColumnNames="TRANSPORT_ID"/>
    </changeSet>

    <!-- 7. Типы тарифов -->
    <changeSet id="7" author="Vlad">
        <createTable tableName="TARIFF_TYPES">
            <column name="TARIFF_TYPE_ID" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="TEXT"/>
        </createTable>

        <insert tableName="TARIFF_TYPES">
            <column name="TARIFF_TYPE_ID" valueNumeric="1"/>
            <column name="CODE" value="RIDES_PACKAGE"/>
            <column name="NAME" value="Пакет поездок до даты"/>
            <column name="DESCRIPTION" value="Фиксированное количество поездок (например, 10 или 20), которые нужно использовать до определённой даты. Остаток поездок - в AVAILABLE_TRAVEL_COUNT, срок - в EXPIRATION_RIDES_PACKAGE карты."/>
        </insert>
        <insert tableName="TARIFF_TYPES">
            <column name="TARIFF_TYPE_ID" valueNumeric="2"/>
            <column name="CODE" value="UNLIMITED_TILL_DATE"/>
            <column name="NAME" value="Безлимит до даты"/>
            <column name="DESCRIPTION" value="Безлимитное количество поездок в течение определённого периода (день/неделя/месяц/год). Срок действия указан в поле unlimited_until_date карты."/>
        </insert>
        <insert tableName="TARIFF_TYPES">
            <column name="TARIFF_TYPE_ID" valueNumeric="3"/>
            <column name="CODE" value="WALLET"/>
            <column name="NAME" value="Пополняемый кошелёк"/>
            <column name="DESCRIPTION" value="Деньги списываются с баланса за каждую поездку. Баланс хранится в поле wallet_balance карты. Можно пополнять."/>
        </insert>
    </changeSet>

    <!-- 8. Обновлённая таблица Карт -->
    <changeSet id="8" author="Vlad">
        <createTable tableName="CARDS">
            <column name="CARD_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CARD_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="CARD_TYPE_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="BIGINT"/>
            <column name="TRANSPORT_ID" type="BIGINT"/>
            <column name="TARIFF_TYPE_ID" type="INT"/>
            <column name="EXPIRATION_RIDES_PACKAGE" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="AVAILABLE_TRAVEL_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="UNLIMITED_UNTIL_DATE" type="TIMESTAMP"/>
            <column name="WALLET_BALANCE" type="DECIMAL(10,2)"/>
            <column name="UNIQUE_TRAVEL_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="MAXIMUM_UNIQUE_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ISSUE_DATE" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRATION_DATE" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            <![CDATA[
                ALTER SEQUENCE CARDS_CARD_ID_SEQ RESTART WITH 1000;
            ]]>
        </sql>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="TRANSPORT_ID"
                                 constraintName="fk_cards_transport_id"
                                 referencedTableName="TRANSPORTS"
                                 referencedColumnNames="TRANSPORT_ID"/>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="CARD_TYPE_ID"
                                 constraintName="fk_cards_card_type_id"
                                 referencedTableName="CARD_TYPES"
                                 referencedColumnNames="CARD_TYPE_ID"/>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="USER_ID"
                                 constraintName="fk_cards_user_id"
                                 referencedTableName="USERS"
                                 referencedColumnNames="USER_ID"/>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="TARIFF_TYPE_ID"
                                 constraintName="fk_cards_tariff_type_id"
                                 referencedTableName="TARIFF_TYPES"
                                 referencedColumnNames="TARIFF_TYPE_ID"/>

    </changeSet>

    <!-- 9. CHECK-ограничение для таблицы CARDS -->
    <changeSet id="9" author="Vlad">
        <sql dbms="postgresql">
            <![CDATA[
                ALTER TABLE CARDS
                ADD CONSTRAINT chk_cards_travel_count
                CHECK (AVAILABLE_TRAVEL_COUNT >= 0);
            ]]>
        </sql>
    </changeSet>

    <!-- 10. Чёрный список -->
    <changeSet id="10" author="Vlad">
        <createTable tableName="BLACK_LIST">
            <column name="CARD_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 11. Индексы -->
    <changeSet id="11" author="Vlad">
        <createIndex tableName="CARDS" indexName="idx_cards_guid">
            <column name="CARD_GUID"/>
        </createIndex>
        <createIndex tableName="BLACK_LIST" indexName="idx_blacklist_guid">
            <column name="CARD_GUID"/>
        </createIndex>
        <createIndex tableName="TERMINALS" indexName="idx_terminals_guid">
            <column name="TERMINAL_GUID"/>
        </createIndex>
    </changeSet>

    <!-- 12. USER_SESSIONS (обновлённая) -->
    <changeSet id="12" author="Vlad">
        <createTable tableName="USER_SESSIONS">
            <column name="SESSION_ID" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TERMINAL_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="CARD_ID" type="BIGINT"/>
            <column name="STARTED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CLOSED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRATION_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="USER_SESSIONS" indexName="IX_SESSIONS">
            <column name="SESSION_ID"/>
            <column name="USER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="USER_SESSIONS"
                                 baseColumnNames="TERMINAL_ID"
                                 constraintName="fk_sessions_terminal_id"
                                 referencedTableName="TERMINALS"
                                 referencedColumnNames="TERMINAL_ID"/>

        <addForeignKeyConstraint baseTableName="USER_SESSIONS"
                                 baseColumnNames="USER_ID"
                                 constraintName="fk_sessions_user_id"
                                 referencedTableName="USERS"
                                 referencedColumnNames="USER_ID"/>

        <addForeignKeyConstraint baseTableName="USER_SESSIONS"
                                 baseColumnNames="CARD_ID"
                                 constraintName="fk_sessions_card_id"
                                 referencedTableName="CARDS"
                                 referencedColumnNames="CARD_ID"/>
    </changeSet>

    <!-- 13. CODES -->
    <changeSet id="13" author="Vlad">
        <createTable tableName="CODES">
            <column name="CODE_UID" type="VARCHAR(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CODE_TYPE" type="CHAR(1)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE_CONTENT" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="ALLOWED_USAGE" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_FROM" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_TO" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            <![CDATA[
                ALTER TABLE CODES
                ADD CONSTRAINT chk_codes_type CHECK (CODE_TYPE IN ('A', 'S'));

                ALTER TABLE CODES
                ADD CONSTRAINT chk_codes_usage CHECK (ALLOWED_USAGE IN ('RW', 'R', '-'));
            ]]>
        </sql>
    </changeSet>

    <!-- 14. MASTER_PASSWORD -->
    <changeSet id="14" author="Vlad">
        <createTable tableName="MASTER_PASSWORD">
            <column name="ID" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="MASTER_PASSWORD_HASH" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- 15. SERVICE_EVENT_TYPES -->
