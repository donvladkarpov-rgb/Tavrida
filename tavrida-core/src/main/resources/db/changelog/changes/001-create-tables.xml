<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. Справочник ролей пользователей -->
    <changeSet id="1" author="Vlad">
        <createTable tableName="USER_ROLES">
            <column name="USER_ROLE_ID" type="INT" autoIncrement="false">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="USER_ROLE_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="1"/>
            <column name="USER_ROLE_NAME" value="Администратор"/>
        </insert>
        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="2"/>
            <column name="USER_ROLE_NAME" value="Администратор перевозчика"/>
        </insert>
        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="3"/>
            <column name="USER_ROLE_NAME" value="Кассир"/>
        </insert>
        <insert tableName="USER_ROLES">
            <column name="USER_ROLE_ID" valueNumeric="4"/>
            <column name="USER_ROLE_NAME" value="Водитель"/>
        </insert>
    </changeSet>

    <!-- 2. Справочник типов карт -->
    <changeSet id="2" author="Vlad">
        <createTable tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" type="INT" autoIncrement="false">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CARD_TYPE_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="1"/>
            <column name="CARD_TYPE_NAME" value="Карта администратора"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="2"/>
            <column name="CARD_TYPE_NAME" value="Карта кассира"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="3"/>
            <column name="CARD_TYPE_NAME" value="Карта водителя"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="4"/>
            <column name="CARD_TYPE_NAME" value="Карта пассажира"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="5"/>
            <column name="CARD_TYPE_NAME" value="Карта активации терминала"/>
        </insert>
        <insert tableName="CARD_TYPES">
            <column name="CARD_TYPE_ID" valueNumeric="6"/>
            <column name="CARD_TYPE_NAME" value="Карта сброса терминала"/>
        </insert>
    </changeSet>

    <!-- 3. Перевозчики -->
    <changeSet id="3" author="Vlad">
        <createTable tableName="CARRIERS">
            <column name="CARRIER_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CARRIER_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="CARRIERS">
            <column name="CARRIER_ID" valueNumeric="1"/>
            <column name="CARRIER_NAME" value="Крымские трамваи"/>
        </insert>
    </changeSet>

    <!-- 4. Пользователи -->
    <changeSet id="4" author="Vlad">
        <createTable tableName="USERS">
            <column name="USER_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="USER_ROLE_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_FIO" type="VARCHAR(255)"/>
            <column name="CARRIER_ID" type="BIGINT"/> <!-- Исправлено: ссылается на CARRIERS.CARRIER_ID (BIGSERIAL) -->
            <column name="USER_PASSWORD_HASH" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="USERS"
                                 baseColumnNames="USER_ROLE_ID"
                                 constraintName="fk_users_user_role_id"
                                 referencedTableName="USER_ROLES"
                                 referencedColumnNames="USER_ROLE_ID"/>

        <addForeignKeyConstraint baseTableName="USERS"
                                 baseColumnNames="CARRIER_ID"
                                 constraintName="fk_users_carrier_id"
                                 referencedTableName="CARRIERS"
                                 referencedColumnNames="CARRIER_ID"/>

        <insert tableName="USERS">
            <column name="USER_ID" valueNumeric="1"/>
            <column name="USER_ROLE_ID" valueNumeric="1"/>
            <column name="USER_FIO" value="root"/>
            <column name="USER_PASSWORD_HASH" value="changeit"/>
        </insert>
        <insert tableName="USERS">
            <column name="USER_ID" valueNumeric="2"/>
            <column name="USER_ROLE_ID" valueNumeric="3"/>
            <column name="USER_FIO" value="Алексей Петрович Свиридюк"/>
            <column name="USER_PASSWORD_HASH" value="FIRST_PASSWORD"/>
        </insert>
    </changeSet>

    <!-- 5. Транспорт -->
    <changeSet id="5" author="Vlad">
        <createTable tableName="TRANSPORTS">
            <column name="TRANSPORT_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TRANSPORT_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="CARRIER_ID" type="BIGINT"> <!-- Исправлено -->
                <constraints nullable="false"/>
            </column>
            <column name="TRANSPORT_NUMBER" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="TRANSPORT_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="TRANSPORTS"
                                 baseColumnNames="CARRIER_ID"
                                 constraintName="fk_transports_carrier_id"
                                 referencedTableName="CARRIERS"
                                 referencedColumnNames="CARRIER_ID"/>
        <insert tableName="TRANSPORTS">
            <column name="TRANSPORT_ID" valueNumeric="1"/>
            <column name="TRANSPORT_GUID" value="264bfe9d-98c5-4cfc-a27b-9b6234054580"/>
            <column name="CARRIER_ID" valueNumeric="1"/>
            <column name="TRANSPORT_NUMBER" value="1"/>
            <column name="TRANSPORT_NAME" value="трамвай"/>
        </insert>
    </changeSet>

    <!-- 6. Терминалы -->
    <changeSet id="6" author="Vlad">
        <createTable tableName="TERMINALS">
            <column name="TERMINAL_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="TRANSPORT_ID" type="BIGINT"> <!-- Исправлено: ссылается на TRANSPORTS.TRANSPORT_ID (BIGSERIAL) -->
                <constraints nullable="false"/>
            </column>
            <column name="TERMINAL_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="TERMINAL_NUMBER" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="TERMINAL_SERIAL" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="TERMINALS"
                                 baseColumnNames="TRANSPORT_ID"
                                 constraintName="fk_terminals_transport_id"
                                 referencedTableName="TRANSPORTS"
                                 referencedColumnNames="TRANSPORT_ID"/>
        <insert tableName="TERMINALS">
            <column name="TERMINAL_ID" valueNumeric="1"/>
            <column name="TRANSPORT_ID" valueNumeric="1"/>
            <column name="TERMINAL_GUID" value="3f2dd185-0540-4d82-ad26-e6a181cb1893"/>
            <column name="TERMINAL_NUMBER" value="A1234"/>
            <column name="TERMINAL_SERIAL" value="A1234_1234"/>
        </insert>
    </changeSet>

    <!-- 7. Карты -->
    <changeSet id="7" author="Vlad">
        <createTable tableName="CARDS">
            <column name="CARD_ID" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CARD_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="CARD_TYPE_ID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="BIGINT"/> <!-- Исправлено: ссылается на USERS.USER_ID (BIGSERIAL) -->
            <column name="TRANSPORT_ID" type="BIGINT"/> <!-- Исправлено: ссылается на TRANSPORTS.TRANSPORT_ID (BIGSERIAL) -->
            <column name="UNIQUE_TRAVEL_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="MAXIMUM_UNIQUE_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="AVAILABLE_TRAVEL_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRATION_DATE" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="TRANSPORT_ID"
                                 constraintName="fk_cards_transport_id"
                                 referencedTableName="TRANSPORTS"
                                 referencedColumnNames="TRANSPORT_ID"/>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="CARD_TYPE_ID"
                                 constraintName="fk_cards_card_type_id"
                                 referencedTableName="CARD_TYPES"
                                 referencedColumnNames="CARD_TYPE_ID"/>

        <addForeignKeyConstraint baseTableName="CARDS"
                                 baseColumnNames="USER_ID"
                                 constraintName="fk_cards_user_id"
                                 referencedTableName="USERS"
                                 referencedColumnNames="USER_ID"/>
        <insert tableName="CARDS">
            <column name="CARD_ID" valueNumeric="1"/>
            <column name="CARD_GUID" value="123e4567-e89b-42d3-a456-556642440000"/>
            <column name="CARD_TYPE_ID" valueNumeric="4"/>
            <column name="USER_ID" valueNumeric="2"/>
            <column name="UNIQUE_TRAVEL_COUNT" valueNumeric="0"/>
            <column name="MAXIMUM_UNIQUE_COUNT" valueNumeric="10000"/>
            <column name="AVAILABLE_TRAVEL_COUNT" valueNumeric="1000"/>
            <column name="EXPIRATION_DATE" valueDate="CURRENT_DATE + INTERVAL '3 years'"/>
        </insert>
    </changeSet>

    <!-- CHECK-ограничение для таблицы CARDS -->
    <changeSet id="7-2" author="developer">
        <sql dbms="postgresql">
            <![CDATA[
        ALTER TABLE CARDS
        ADD CONSTRAINT chk_cards_travel_count
        CHECK (AVAILABLE_TRAVEL_COUNT >= 0);
        ]]>
        </sql>
    </changeSet>

    <!-- 8. Чёрный список -->
    <changeSet id="8" author="Vlad">
        <createTable tableName="BLACK_LIST">
            <column name="CARD_GUID" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 9. Индексы для производительности -->
    <changeSet id="9" author="Vlad">
        <createIndex tableName="CARDS" indexName="idx_cards_guid">
            <column name="CARD_GUID"/>
        </createIndex>

        <createIndex tableName="BLACK_LIST" indexName="idx_blacklist_guid">
            <column name="CARD_GUID"/>
        </createIndex>

        <createIndex tableName="TERMINALS" indexName="idx_terminals_guid">
            <column name="TERMINAL_GUID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>